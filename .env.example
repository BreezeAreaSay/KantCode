# Скопируйте в .env и поправьте. Файл .env в репозиторий не попадает.

# --- источник ---
TV_SOURCE_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
# Максимум вакансий за один запуск
TV_MAX_VACANCIES=100
# Размер страницы (портал отдаёт не больше 100). 100 вакансий по 50 — это две страницы.
TV_PAGE_SIZE=50
# Расписание для команды schedule: минуты часы день-месяца месяц день-недели
TV_SCHEDULE=0 6 * * *
# Куда сохранять report.json, last_run.json и кэш
TV_OUTPUT_DIR=reports

# --- ИИ: любой сервер с OpenAI-совместимым /chat/completions ---
TV_AI_ENABLED=true
# Локальная Ollama (ключ не нужен)
TV_AI_BASE_URL=http://localhost:11434/v1
TV_AI_MODEL=qwen2.5:7b
TV_AI_API_KEY=
# Секунд на один ответ модели
TV_AI_TIMEOUT=180
# Попыток на один запрос, если сервер занят или просит подождать (429, 503)
TV_AI_RETRIES=3
# Сколько вакансий разбирать одновременно
TV_AI_WORKERS=2
# Сколько вакансий отдавать модели за запуск (0 — все)
TV_AI_MAX_VACANCIES=0
# Принимать неоднозначность от модели только с признаком расплывчатости в цитате
TV_AI_STRICT=true
