# Скопируйте этот файл в .env. Файл .env в репозиторий не попадает.
# Читается одинаково при запуске в Docker и при запуске python -m transparent_vacancy.
#
# Сервису нужна модель. Выберите один способ.
#
# Способ А: токен. Вставьте ключ OpenRouter (бесплатная регистрация на openrouter.ai,
# покупка не нужна). Адрес сервера и бесплатные модели подставятся сами.
TV_AI_API_KEY=
#
# Способ Б: локальная модель. Оставьте ключ пустым.
#   В Docker:    docker compose --profile local up -d    (Ollama и модель скачаются сами)
#   Без Docker:  установите Ollama и выполните  ollama pull qwen2.5:7b

# ---------------------------------------------------------------------------
# Всё ниже менять не обязательно. Раскомментируйте строку, чтобы изменить значение.

# --- модель ---
# Свой сервер с OpenAI-совместимым /chat/completions вместо OpenRouter и Ollama:
# TV_AI_BASE_URL=https://openrouter.ai/api/v1
# TV_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Запасные модели через запятую, если основная упёрлась в лимит: «модель» или «модель@адрес-сервера»
# TV_AI_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
# Ollama, установленная на самой машине, из Docker видна так:
# TV_AI_BASE_URL=http://host.docker.internal:11434/v1
# Локальная модель для способа Б
# TV_AI_LOCAL_MODEL=qwen2.5:7b
# Использовать ли модель вообще
# TV_AI_ENABLED=true
# Секунд на один ответ модели (с ключом OpenRouter по умолчанию 600)
# TV_AI_TIMEOUT=180
# Попыток на один запрос, если сервер занят или просит подождать (429, 503)
# TV_AI_RETRIES=3
# Сколько вакансий разбирать одновременно (с ключом OpenRouter по умолчанию 8)
# TV_AI_WORKERS=2
# Сколько вакансий отдавать модели за запуск (0 — все)
# TV_AI_MAX_VACANCIES=0
# Принимать неоднозначность от модели только с признаком расплывчатости в цитате
# TV_AI_STRICT=true

# --- источник ---
# TV_SOURCE_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
# Максимум вакансий за один запуск
# TV_MAX_VACANCIES=100
# Размер страницы (портал отдаёт не больше 100). 100 вакансий по 50 — это две страницы.
# TV_PAGE_SIZE=50
# Расписание для команды schedule: минуты часы день-месяца месяц день-недели
# TV_SCHEDULE=0 6 * * *
# Куда сохранять report.json, last_run.json и кэш (в Docker всегда ./reports)
# TV_OUTPUT_DIR=reports
# Секунд на один запрос к порталу и число попыток
# TV_HTTP_TIMEOUT=60
# TV_HTTP_RETRIES=3
